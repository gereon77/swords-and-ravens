# Copy this file to .env.prod on the droplet and fill in real values. .env.prod itself is
# gitignored — never commit real secrets. Used by: docker compose -f docker-compose.prod.yml
# --env-file .env.prod up -d

# Which pre-built image tags to deploy. GitHub Actions CI builds+pushes these to GHCR (mirroring
# the old .github/workflows/deploy.yml) — the droplet only ever pulls, never builds, matching
# `docker-compose.prod.yml`'s `image:` (not `build:`) entries for website/game-server. Leave unset
# to default to `:latest`; the CI/CD pipeline will instead pin these to a specific commit SHA per
# deploy once it exists.
WEBSITE_IMAGE=ghcr.io/gereon77/swords-and-ravens/website:latest
GAME_SERVER_IMAGE=ghcr.io/gereon77/swords-and-ravens/game-server:latest

# Postgres password (also embedded into the website's ConnectionStrings__DefaultConnection below
# it in docker-compose.prod.yml — same value, single source of truth).
DB_PASSWORD=

# Basic Auth credentials the TypeScript game server uses to call the website's private
# GameServerApi (port 8001, never published to the host — see MIGRATION_PLAN.md §6.2). Pick any
# strong random password; the username can stay as-is.
MASTER_API_USERNAME=game-server
MASTER_API_PASSWORD=

# OAuth app credentials — leave blank to disable a provider entirely (Program.cs only registers
# a provider when both its ClientId and ClientSecret are non-empty).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email for registration/password-reset/game-notification emails. Precedence: Amazon SES's own
# API (EMAIL_SES_ACCESS_KEY_ID) > a generic bearer-token API provider (EMAIL_API_KEY, e.g. Resend)
# > SMTP (EMAIL_HOST) - see agot-bg-website-dotnet/README.md's "Email" section for a
# provider/cost comparison. Only set ONE of these three groups; whichever is set and highest in
# that precedence wins.
# EMAIL_SES_ACCESS_KEY_ID / EMAIL_SES_SECRET_ACCESS_KEY: an IAM access key (NOT SES's SMTP
# username/password, which only work for the SMTP path below) with ses:SendEmail permission.
EMAIL_SES_ACCESS_KEY_ID=
EMAIL_SES_SECRET_ACCESS_KEY=
EMAIL_SES_REGION=eu-north-1
# EMAIL_API_HOST only needs overriding if you switch to a different bearer-token API provider
# than Resend (whose base URL is the default).
EMAIL_API_KEY=
EMAIL_API_HOST=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=Swords and Ravens <admin@winordie.net>

# Optional: Sentry error tracking, shared by both the game server and the website (carried over
# from the old Dokku `play` app's SENTRY_DSN var). One Sentry project can safely receive events
# from both — each event is tagged with its own platform (node vs csharp). Leave blank to disable
# — server.ts only calls Sentry.init() when set, and Program.cs only calls UseSentry() when set.
SENTRY_DSN=
