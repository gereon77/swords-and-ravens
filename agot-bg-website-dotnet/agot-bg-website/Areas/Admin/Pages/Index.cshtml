@page
@{
    ViewData["Title"] = "Admin";
}

<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Admin</h1>
    <a class="btn btn-sm" href="/coreadmin" target="_blank" rel="noopener">Core Admin</a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Users/Index">
        <h2 class="text-lg font-semibold">Users</h2>
        <p class="opacity-70">Search users, ban/unban, edit roles.</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Games/Index">
        <h2 class="text-lg font-semibold">Games</h2>
        <p class="opacity-70">Search games, view/edit the raw serialized game, cancel a game.</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Rooms/Index">
        <h2 class="text-lg font-semibold">Rooms</h2>
        <p class="opacity-70">Browse chat rooms (public/issues/per-game).</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Messages/Index">
        <h2 class="text-lg font-semibold">Messages</h2>
        <p class="opacity-70">Browse chat messages for a specific room.</p>
    </a>
</div>

