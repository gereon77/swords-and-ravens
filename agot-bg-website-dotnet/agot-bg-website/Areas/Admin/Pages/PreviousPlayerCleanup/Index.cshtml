@page
@model agot_bg_website.Areas.Admin.Pages.PreviousPlayerCleanup.IndexModel
@{
    ViewData["Title"] = "Admin - PreviousPlayerInGame cleanup";
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Corrupted PreviousPlayerInGame rows</h1>

<p class="mb-4 max-w-3xl">
    Rows that can only have been created by the now-fixed lobby-seat-change bug: a user left a
    game's lobby before it ever started, and that was mistakenly recorded as a mid-game removal.
    See <code>agot_bg_website.Domain.PreviousPlayerCleanup</code>'s doc comment for exactly how
    these are identified and why the check is safe (it can never match a legitimate
    vote/clock-timeout removal, nor a legacy pre-migration row). Deleting a row here only affects
    the "left early" count and the "previously participated games" list for that user - it never
    changes anyone's win-rate, which already only counts Ongoing/Finished games.
</p>

<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.Rows.Count > 0)
{
    <form method="post" asp-page-handler="DeleteAllShown" class="mb-4" onsubmit="return confirm('Delete ALL matching PreviousPlayerInGame rows (not just this page)? This cannot be undone.');">
        <button type="submit" class="btn btn-sm btn-error">Delete all matching rows</button>
    </form>
}

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>Game</th>
                <th>Game state</th>
                <th>User</th>
                <th>Replaced at</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>
                        @if (row.Game is not null)
                        {
                            <a class="link" asp-area="Admin" asp-page="/Games/Edit" asp-route-id="@row.GameId">@row.Game.Name</a>
                        }
                        else
                        {
                            @row.GameId
                        }
                    </td>
                    <td>@row.Game?.State</td>
                    <td>
                        @if (row.User is not null)
                        {
                            <a class="link" href="/user/@row.UserId" target="_blank" rel="noopener noreferrer">@row.User.DisplayName</a>
                        }
                        else
                        {
                            @row.UserId
                        }
                    </td>
                    <td>@row.ReplacedAt?.ToLocalTime().ToString("g")</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" onsubmit="return confirm('Delete this row? This cannot be undone.');">
                            <button type="submit" class="btn btn-sm btn-error">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Rows.Count == 0)
{
    <p>No corrupted rows found.</p>
}

<partial name="_Pager" model="Model.Pager" />
