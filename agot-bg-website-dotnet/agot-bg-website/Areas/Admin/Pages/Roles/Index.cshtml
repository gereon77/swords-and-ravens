@page
@model agot_bg_website.Areas.Admin.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Admin - Roles";
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Roles &amp; permissions</h1>
<p class="mb-4 text-sm opacity-70">
    Grant a permission to every member of a role here. To grant a permission to a single user
    without changing their roles, use <a class="link" asp-area="Admin" asp-page="/Users/Index">Edit roles</a>
    on that user instead.
</p>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>Role</th>
                <th>Permissions</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@(role.Permissions.Count == 0 ? "—" : string.Join(", ", role.Permissions))</td>
                    <td><a class="btn btn-sm" asp-page="./Edit" asp-route-roleName="@role.Name">Edit permissions</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
