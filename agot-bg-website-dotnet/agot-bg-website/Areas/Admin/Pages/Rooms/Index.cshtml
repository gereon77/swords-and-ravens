@page
@model agot_bg_website.Areas.Admin.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Admin - Rooms";
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Rooms</h1>

<form method="get" class="mb-4 flex gap-2">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="text" name="Search" value="@Model.Search" class="input input-bordered" placeholder="Search by name or id" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Public</th>
                <th>Max retrieve count</th>
                <th>Messages</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model.Rooms)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@(room.Public ? "Yes" : "No")</td>
                    <td>@(room.MaxRetrieveCount?.ToString() ?? "-")</td>
                    <td>@Model.MessageCountByRoomId.GetValueOrDefault(room.Id, 0).ToString("N0")</td>
                    <td>@room.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a class="btn btn-sm" asp-area="Admin" asp-page="/Messages/Index" asp-route-roomId="@room.Id">View messages</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
