@page
@model agot_bg_website.Areas.Admin.Pages.Users.IndexModel
@using agot_bg_website.Infrastructure.Auth
@{
    ViewData["Title"] = "Admin - Users";
}

<h1 class="text-2xl font-bold mb-4">Users</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="get" class="mb-4 flex gap-2">
    <input type="text" name="Search" value="@Model.Search" class="input input-bordered" placeholder="Search by username, email or id" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var roles = Model.RolesByUserId.GetValueOrDefault(user.Id, []);
                var isBanned = roles.Contains(RoleNames.Banned);
                <tr>
                    <td>
                        @if (user.IsDeleted)
                        {
                            @user.DisplayName
                            <span class="badge badge-neutral">Deleted</span>
                        }
                        else
                        {
                            <a class="link" href="/User/@user.Id">@user.DisplayName</a>
                        }
                    </td>
                    <td>@user.Email @(user.IsDeleted ? "" : user.EmailConfirmed ? "" : "(unconfirmed)")</td>
                    <td>@string.Join(", ", roles)</td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="flex gap-2">
                        @if (!user.IsDeleted)
                        {
                            <a class="btn btn-sm" asp-page="./Edit" asp-route-id="@user.Id">Edit roles</a>
                            <form method="post" asp-page-handler="ToggleBan" asp-route-id="@user.Id" asp-route-Search="@Model.Search">
                                <button type="submit" class="btn btn-sm @(isBanned ? "btn-success" : "btn-error")">
                                    @(isBanned ? "Unban" : "Ban")
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" asp-route-Search="@Model.Search" onsubmit="return confirm('Permanently delete this account? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-error">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
