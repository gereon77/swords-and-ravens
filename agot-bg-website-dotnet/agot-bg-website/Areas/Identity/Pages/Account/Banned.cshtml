@page
@model BannedModel
@{
    ViewData["Title"] = "Account banned";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">Your account has been banned and can no longer log in.</p>
    <p>If you think this is a mistake, please get in touch with the site administrators.</p>
</header>
