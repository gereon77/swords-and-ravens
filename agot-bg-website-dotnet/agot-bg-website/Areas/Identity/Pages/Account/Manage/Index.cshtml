@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @if (Model.CanChangeUsername)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewUsername" class="form-control" placeholder="Please choose your username." />
                    <label asp-for="Input.NewUsername" class="form-label"></label>
                    <span asp-validation-for="Input.NewUsername" class="text-danger"></span>
                    <div class="form-text text-muted">You can change your username once. After updating, it cannot be changed again.</div>
                </div>
                <button id="update-profile-button" type="submit" class="btn btn-primary">Save</button>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" disabled />
                    <label asp-for="Username" class="form-label"></label>
                    <div class="form-text text-muted">Username was changed on @(Model.LastUsernameUpdateTime?.ToLocalTime().ToString("g") ?? "a previous date") and cannot be modified again.</div>
                </div>
            }
        </form>
    </div>
</div>

<hr class="my-8 border-base-300" />

<div class="row">
    <div class="col-md-6">
        <form id="profile-text-form" method="post" asp-page-handler="UpdateProfileText">
            <div class="form-floating mb-3">
                <textarea asp-for="ProfileTextInput.ProfileText" class="form-control" style="height: 8rem" placeholder="Say something about you."></textarea>
                <label asp-for="ProfileTextInput.ProfileText" class="form-label"></label>
                <span asp-validation-for="ProfileTextInput.ProfileText" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Change</button>
        </form>
    </div>
</div>

<hr class="my-8 border-base-300" />

<div class="row">
    <div class="col-md-9">
        <h4>Preferences</h4>
        <form id="preferences-form" method="post" asp-page-handler="UpdatePreferences">
            <div class="flex flex-col gap-2 mb-3">
                <div class="form-check text-nowrap">
                    <input asp-for="PreferencesInput.EmailNotificationActive" class="form-check-input" />
                    <label asp-for="PreferencesInput.EmailNotificationActive" class="form-check-label"></label>
                </div>
                <div class="form-check text-nowrap">
                    <input asp-for="PreferencesInput.MuteGames" class="form-check-input" />
                    <label asp-for="PreferencesInput.MuteGames" class="form-check-label"></label>
                </div>
                <div class="form-check text-nowrap">
                    <input asp-for="PreferencesInput.UseHouseNamesForChat" class="form-check-input" />
                    <label asp-for="PreferencesInput.UseHouseNamesForChat" class="form-check-label"></label>
                </div>
                <div class="form-check text-nowrap">
                    <input asp-for="PreferencesInput.UseMapScrollbar" class="form-check-input" />
                    <label asp-for="PreferencesInput.UseMapScrollbar" class="form-check-label"></label>
                </div>
                <div class="form-check text-nowrap">
                    <input asp-for="PreferencesInput.GameStateColumnRight" class="form-check-input" />
                    <label asp-for="PreferencesInput.GameStateColumnRight" class="form-check-label"></label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
