@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<h1 class="text-2xl font-bold mb-1">Manage your account</h1>

<div>
    <h2 class="text-lg font-semibold text-base-content/80 mb-4">Change your account settings</h2>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-3">
            <div class="card bg-base-200 shadow-md border border-base-300 p-4">
                <partial name="_ManageNav" />
            </div>
        </div>
        <div class="md:col-span-9">
            <div class="card bg-base-200 shadow-md border border-base-300 p-6">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
