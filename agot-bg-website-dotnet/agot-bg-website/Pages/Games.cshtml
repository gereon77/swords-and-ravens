@page
@model GamesModel
@using agot_bg_website.Pages.Shared
@{
    ViewData["Title"] = "All Games";
}

@{
    var noGamesAtAll = Model.OpenGames.Count == 0 && Model.OngoingGames.Count == 0;
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">All Games</h1>
    @if (Model.CanCreateGame)
    {
        <button type="button" id="toggle-create-game" class="btn btn-circle btn-primary" title="Create a new game" aria-expanded="@(noGamesAtAll ? "true" : "false")" aria-controls="create-game-panel">
            <span class="text-xl leading-none">+</span>
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error mb-4">@Model.ErrorMessage</div>
}

@await Html.PartialAsync("_ChatWidget", new agot_bg_website.Pages.Shared.ChatWidgetModel(
    agot_bg_website.Infrastructure.Chat.RoomSeeder.PublicRoomId,
    agot_bg_website.Infrastructure.Chat.RoomSeeder.IssuesRoomId,
    User.Identity?.IsAuthenticated ?? false))

@if (Model.CanCreateGame)
{
    <div id="create-game-panel" class="card bg-base-200 shadow-md border border-base-300 p-6 mb-8 @(noGamesAtAll ? "" : "hidden")">
        <h2 class="text-lg font-semibold mb-3">Create a new game</h2>
        <form method="post" asp-page-handler="CreateGame" class="flex flex-col sm:flex-row sm:items-center gap-3">
            <input type="text" name="name" class="input input-bordered flex-1" placeholder="Enter game name..." maxlength="200" required />
            <button type="submit" class="btn btn-primary w-full sm:w-auto px-8">Create Game</button>
        </form>
    </div>
    <script>
        document.getElementById('toggle-create-game')?.addEventListener('click', () => {
            const panel = document.getElementById('create-game-panel');
            const btn = document.getElementById('toggle-create-game');
            const isHidden = panel.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', (!isHidden).toString());
            if (!isHidden) {
                panel.querySelector('input[name="name"]')?.focus();
            }
        });
    </script>
}

<section class="mb-10">
    <h2 class="text-xl font-semibold mb-3">Your games <span class="badge badge-neutral badge-lg align-middle ml-1">@Model.MyGames.Count</span></h2>
    @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
    {
        Games = Model.MyGames,
        ShowStateBadge = true,
        IsAuthenticated = true,
        EmptyMessage = "You are not currently part of any game."
    })
</section>

<section class="mb-10">
    <h2 class="text-xl font-semibold mb-3">Open games <span class="badge badge-neutral badge-lg align-middle ml-1">@Model.OpenGames.Count</span></h2>
    @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
    {
        Games = Model.OpenGames,
        ShowStateBadge = false,
        IsAuthenticated = true,
        EmptyMessage = "No open games right now."
    })
</section>

<section class="mb-10">
    <h2 class="text-xl font-semibold mb-3">Ongoing games <span class="badge badge-warning badge-lg align-middle ml-1">@Model.OngoingGames.Count</span></h2>
    @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
    {
        Games = Model.OngoingGames,
        ShowStateBadge = false,
        IsAuthenticated = true,
        EmptyMessage = "No ongoing games right now."
    })
</section>

@if (Model.ReplacementNeededGames.Count > 0)
{
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3" title="Games where the last move was more than 2 days ago and the player being waited on has not logged in for 8 days.">
            Games waiting for inactive players <span class="badge badge-error badge-lg align-middle ml-1">@Model.ReplacementNeededGames.Count</span>
        </h2>
        @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
        {
            Games = Model.ReplacementNeededGames,
            ShowStateBadge = false,
            ShowJoinAsWaited = true,
            CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
            IsAuthenticated = true
        })
    </section>
}

@if (Model.CanPlayAsAnotherPlayer && Model.InactiveGames.Count > 0)
{
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3">Games without a move for 5 days <span class="badge badge-neutral badge-lg align-middle ml-1">@Model.InactiveGames.Count</span></h2>
        @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
        {
            Games = Model.InactiveGames,
            ShowStateBadge = false,
            IsAuthenticated = true
        })
    </section>
}

@if (Model.CanPlayAsAnotherPlayer && Model.InactiveTournamentGames.Count > 0)
{
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3">Tournament games without a move for 2 days <span class="badge badge-neutral badge-lg align-middle ml-1">@Model.InactiveTournamentGames.Count</span></h2>
        @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
        {
            Games = Model.InactiveTournamentGames,
            ShowStateBadge = false,
            IsAuthenticated = true
        })
    </section>
}

@if (Model.CanCancelGame && Model.InactivePrivateGames.Count > 0)
{
    <section class="mb-10">
        <h2 class="text-xl font-semibold mb-3">Inactive private games <span class="badge badge-neutral badge-lg align-middle ml-1">@Model.InactivePrivateGames.Count</span></h2>
        @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
        {
            Games = Model.InactivePrivateGames,
            ShowStateBadge = false,
            IsAuthenticated = true
        })
    </section>
}
