@page
@model GamesModel
@{
    ViewData["Title"] = "All Games";
}

<h1 class="text-2xl font-bold mb-4">All Games</h1>

<section class="mb-8">
    <h2 class="text-xl font-semibold mb-2">Open games <span class="badge">@Model.OpenGames.Count</span></h2>
    @if (Model.OpenGames.Count == 0)
    {
        <p class="opacity-70">No open games right now.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Players</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model.OpenGames)
                    {
                        <tr>
                            <td>@game.Name</td>
                            <td>@(game.OwnerUser?.UserName)</td>
                            <td>@game.Players.Count</td>
                            <td>@game.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2 class="text-xl font-semibold mb-2">Ongoing games <span class="badge">@Model.OngoingGames.Count</span></h2>
    @if (Model.OngoingGames.Count == 0)
    {
        <p class="opacity-70">No ongoing games right now.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Players</th>
                        <th>Last active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model.OngoingGames)
                    {
                        <tr>
                            <td>@game.Name</td>
                            <td>@(game.OwnerUser?.UserName)</td>
                            <td>@game.Players.Count</td>
                            <td>@game.LastActiveAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
