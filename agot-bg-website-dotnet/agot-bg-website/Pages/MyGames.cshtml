@page
@model MyGamesModel
@{
    ViewData["Title"] = "My Games";
}

<h1 class="text-2xl font-bold mb-4">My Games</h1>

@if (Model.MyGames.Count == 0)
{
    <p class="opacity-70">You are not currently part of any game.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>State</th>
                    <th>Players</th>
                    <th>Last active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model.MyGames)
                {
                    <tr>
                        <td>@game.Name</td>
                        <td>@(game.OwnerUser?.UserName)</td>
                        <td>@game.State</td>
                        <td>@game.Players.Count</td>
                        <td>@game.LastActiveAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
