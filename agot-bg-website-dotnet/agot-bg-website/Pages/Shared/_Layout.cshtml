<!DOCTYPE html>
<html lang="en" data-theme="swordsandravens">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Swords and Ravens</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/agot_bg_website.styles.css" asp-append-version="true" />
</head>
<body class="h-screen bg-base-100 text-base-content flex flex-col overflow-hidden">
    <header class="shrink-0">
        <nav class="navbar bg-base-200 border-b border-base-300 shadow-md">
            <div class="container flex items-center justify-between">
                <a class="btn btn-ghost text-xl normal-case text-primary font-bold tracking-wide" asp-area="" asp-page="/Index">
                    &#x1F426; Swords and Ravens
                </a>
                <div class="flex items-center gap-1">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="nav-link" asp-area="" asp-page="/Games">All Games</a>
                        <a class="nav-link" asp-area="" asp-page="/MyGames">My Games</a>
                        <a class="nav-link" asp-area="" asp-page="/Rules">Rules</a>
                        <a class="nav-link" href="https://faq.swordsandravens.net" target="_blank" rel="noopener">FAQ</a>
                    }
                    <a class="nav-link" asp-area="" asp-page="/About">About</a>
                    @if (User.IsInRole(agot_bg_website.Infrastructure.Auth.RoleNames.Admin))
                    {
                        <a class="nav-link" asp-area="Admin" asp-page="/Index">Admin</a>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-1 min-h-0 overflow-y-auto">
        <div class="container">
            <main role="main" class="pb-3 pt-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-t border-base-300 py-3 text-sm opacity-70 shrink-0">
        <div class="container flex items-center justify-center gap-1">
            <span>&copy; 2026 - Swords and Ravens -</span>
            <a class="link link-hover" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>
    <partial name="_CookieConsentPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
