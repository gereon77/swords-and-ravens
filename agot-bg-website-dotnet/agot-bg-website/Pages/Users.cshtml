@page
@model agot_bg_website.Pages.UsersModel
@using agot_bg_website.Infrastructure.Auth
@{
    ViewData["Title"] = "Users";
}

<h1 class="text-2xl font-bold mb-4">Users</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="get" class="mb-4 flex gap-2">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="text" name="Search" value="@Model.Search" class="input input-bordered" placeholder="Search by username" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Roles</th>
                <th>Created</th>
                @if (Model.CanManageUserStatus)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var roles = Model.RolesByUserId.GetValueOrDefault(user.Id, []);
                var isProtected = roles.Contains(RoleNames.Admin) || roles.Contains(RoleNames.HighMember);
                var isBanned = roles.Contains(RoleNames.Banned);
                var isOnProbation = roles.Contains(RoleNames.OnProbation);
                var isTongueless = roles.Contains(RoleNames.Tongueless);
                <tr>
                    <td>
                        <a class="link" href="/user/@user.Id">@user.DisplayName</a>
                    </td>
                    <td class="flex flex-wrap gap-1">
                        @foreach (var role in roles)
                        {
                            <span class="badge @RoleBadges.Classes.GetValueOrDefault(role, "badge-neutral")">@role</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                    @if (Model.CanManageUserStatus)
                    {
                        <td class="flex flex-wrap gap-2">
                            @if (isProtected)
                            {
                                <span class="opacity-50 text-sm">Protected</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.OnProbation" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">
                                    <button type="submit" class="btn btn-sm @(isOnProbation ? "btn-success" : "btn-warning")">
                                        @(isOnProbation ? "Remove probation" : "On probation")
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.Tongueless" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">
                                    <button type="submit" class="btn btn-sm @(isTongueless ? "btn-success" : "btn-warning")">
                                        @(isTongueless ? "Remove tongueless" : "Tongueless")
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.Banned" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">
                                    <button type="submit" class="btn btn-sm @(isBanned ? "btn-success" : "btn-error")">
                                        @(isBanned ? "Unban" : "Ban")
                                    </button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
