{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:8000"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTP_PORTS": "8000",
        "ConnectionStrings__DefaultConnection": "Host=host.docker.internal;Port=5432;Database=snr_dotnet;Username=postgres;Password=example",
        "ConnectionStrings__Redis": "host.docker.internal:6379"
      },
      "httpPort": 8000,
      "containerRunArguments": "-p 8001:8001",
      "publishAllPorts": false,
      "useSSL": false
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}