{
  // "Production" = the real swordsandravens.net cutover, running on the same DigitalOcean Docker
  // droplet as the pre-cutover "Staging" dogfooding environment (see appsettings.Staging.json),
  // just with ASPNETCORE_ENVIRONMENT=Production (docker-compose.prod.yml) instead of Staging - see
  // MIGRATION_PLAN.md §16/§18. Api/NotificationsApi.cs and Api/ChatWebSocketApi.cs
  // (NotifyChatPartnerAsync) both read PublicSiteUrl to build /play/{gameId} links in emails
  // instead of trusting the inbound request's Host header (that header is unreliable behind the
  // reverse proxy / on the private GameServerApi port - see MIGRATION_PLAN.md §6.2/§9.1).
  "PublicSiteUrl": "https://swordsandravens.net",
  // Semicolon-delimited (ASP.NET Core's HostFiltering middleware convention, not comma). Must
  // include both the public domain (what browsers send as Host) AND the bare "website" service
  // name (what the game-server container sends as Host when it calls this container's private
  // GameServerApi at http://website:8001/api - see docker-compose.prod.yml's
  // MASTER_API_BASE_URL). An entry with no port (like "website" here) matches that host on any
  // port, so it covers both the public :8000 and private :8001 Kestrel endpoints. Without it,
  // every game-server -> website API call got rejected with HostFiltering's 400 "Invalid
  // Hostname" page, since "website:8001" didn't match a host-only allow-list of the domain.
  "AllowedHosts": "swordsandravens.net;website",
  // Connection strings, OAuth client secrets, GameServer:MasterApiPassword, and Email credentials
  // are intentionally NOT set here - they're real secrets and this file is committed to git. On
  // the droplet they're supplied as environment variable overrides in the production
  // docker-compose.yml (ConnectionStrings__DefaultConnection, ConnectionStrings__Redis,
  // Authentication__Google__ClientSecret, etc.), sourced from a gitignored .env file - same
  // pattern as the local dev docker-compose.yml at the repo root.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
